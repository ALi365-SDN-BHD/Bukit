<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BukitGenerateYamlStaticContext Condition="'$(BukitGenerateYamlStaticContext)' == ''">false</BukitGenerateYamlStaticContext>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bukit.Config\Bukit.Config.csproj" />
    <ProjectReference Include="..\Bukit.Engine.Abstractions\Bukit.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\Bukit.Shared\Bukit.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup Condition="'$(BukitGenerateYamlStaticContext)' == 'true'">
    <Compile Remove="ThemeManifestYamlStaticContext.Generated.cs" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" PrivateAssets="all" />
  </ItemGroup>

</Project>
