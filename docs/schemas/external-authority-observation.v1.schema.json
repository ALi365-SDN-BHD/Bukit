{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bukit.dev/schemas/external-authority-observation.v1.json",
  "title": "Bukit External Authority Observation Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "provider", "collectedAt", "collectionMethod", "rows"],
  "properties": {
    "schema": { "const": "https://bukit.dev/schemas/external-authority-observation.v1.json" },
    "schemaVersion": { "const": "1.0" },
    "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "collectionMethod": { "enum": ["api", "export", "manual"] },
    "rows": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceUrl", "sourceType", "observedAt", "status", "questionKey", "topicKey", "entityKey", "contextHash", "citedUrls"],
        "anyOf": [
          { "required": ["questionKey"], "properties": { "questionKey": { "type": "string" } } },
          { "required": ["topicKey"], "properties": { "topicKey": { "type": "string" } } },
          { "required": ["entityKey"], "properties": { "entityKey": { "type": "string" } } }
        ],
        "properties": {
          "sourceUrl": { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)" },
          "sourceType": { "enum": ["official", "regulator", "research", "news", "association", "repository", "forum", "other"] },
          "observedAt": { "type": "string", "format": "date-time" },
          "status": { "enum": ["active", "deleted", "unavailable"] },
          "questionKey": { "type": ["string", "null"], "pattern": "^question:sha256:[0-9a-f]{64}$" },
          "topicKey": { "type": ["string", "null"], "pattern": "^topic:sha256:[0-9a-f]{64}$" },
          "entityKey": { "type": ["string", "null"], "pattern": "^entity:sha256:[0-9a-f]{64}$" },
          "contextHash": { "type": "string", "pattern": "^context:sha256:[0-9a-f]{64}$" },
          "citedUrls": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)" }
          }
        }
      }
    }
  }
}
