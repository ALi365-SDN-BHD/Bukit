{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bukit.dev/schemas/seo-observation.v1.json",
  "title": "Bukit SEO Observation Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "provider", "scope", "collectedAt", "window", "rows"],
  "properties": {
    "schema": { "const": "https://bukit.dev/schemas/seo-observation.v1.json" },
    "schemaVersion": { "const": "1.0" },
    "provider": { "enum": ["google-search-console", "google-analytics-4"] },
    "scope": { "const": "google-organic" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "window": { "$ref": "#/$defs/window" },
    "rows": {
      "type": "array",
      "maxItems": 100000,
      "items": { "oneOf": [{ "$ref": "#/$defs/gscRow" }, { "$ref": "#/$defs/ga4Row" }] }
    }
  },
  "oneOf": [
    {
      "properties": {
        "provider": { "const": "google-search-console" },
        "rows": { "items": { "$ref": "#/$defs/gscRow" } }
      }
    },
    {
      "properties": {
        "provider": { "const": "google-analytics-4" },
        "rows": { "items": { "$ref": "#/$defs/ga4Row" } }
      }
    }
  ],
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "timeZone"],
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "timeZone": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "gscRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "impressions", "clicks", "averagePosition"],
      "properties": {
        "url": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "impressions": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "clicks": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "averagePosition": { "type": "number", "minimum": 0, "maximum": 1.7976931348623157e308 }
      }
    },
    "ga4Row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sessions", "engagedSessions", "keyEvents"],
      "properties": {
        "url": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "sessions": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "engagedSessions": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "keyEvents": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      }
    }
  }
}
