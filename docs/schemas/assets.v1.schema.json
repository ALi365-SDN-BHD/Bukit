{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bukit.dev/schemas/assets.v1.json",
  "title": "Bukit Asset Inventory",
  "type": "object",
  "required": ["schema", "schemaVersion", "assets"],
  "properties": {
    "schema": { "const": "https://bukit.dev/schemas/assets.v1.json" },
    "schemaVersion": { "const": "1.0" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "source", "hash", "size"],
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string" },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
