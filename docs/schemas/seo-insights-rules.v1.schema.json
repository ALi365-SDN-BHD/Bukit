{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bukit.dev/schemas/seo-insights-rules.v1.json",
  "title": "Bukit SEO Insights Rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "siteHost", "hostAliases", "ignoredQueryParameters", "thresholds", "priorities"],
  "properties": {
    "schema": { "const": "https://bukit.dev/schemas/seo-insights-rules.v1.json" },
    "schemaVersion": { "const": "1.0" },
    "siteHost": { "$ref": "#/$defs/dnsHost" },
    "hostAliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dnsHost" }
    },
    "ignoredQueryParameters": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
    },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "priorities": { "$ref": "#/$defs/priorities" }
  },
  "$defs": {
    "dnsHost": {
      "type": "string",
      "pattern": "^(?![0-9]+(?:\\.[0-9]+){3}\\.?$)(?=.{1,254}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "positiveFiniteNumber": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1.7976931348623157e308
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumSearchImpressions",
        "maximumLowImpressions",
        "minimumAnalyticsSessions",
        "lowCtr",
        "lowEngagementRate",
        "highEngagementRate",
        "opportunityPositionMinimum",
        "opportunityPositionMaximum"
      ],
      "properties": {
        "minimumSearchImpressions": { "$ref": "#/$defs/count" },
        "maximumLowImpressions": { "$ref": "#/$defs/count" },
        "minimumAnalyticsSessions": { "$ref": "#/$defs/count" },
        "lowCtr": { "$ref": "#/$defs/ratio" },
        "lowEngagementRate": { "$ref": "#/$defs/ratio" },
        "highEngagementRate": { "$ref": "#/$defs/ratio" },
        "opportunityPositionMinimum": { "$ref": "#/$defs/positiveFiniteNumber" },
        "opportunityPositionMaximum": { "$ref": "#/$defs/positiveFiniteNumber" }
      }
    },
    "priorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snippetMismatch", "landingQuality", "discoverability", "positionOpportunity"],
      "properties": {
        "snippetMismatch": { "enum": ["P0", "P1", "P2"] },
        "landingQuality": { "enum": ["P0", "P1", "P2"] },
        "discoverability": { "enum": ["P0", "P1", "P2"] },
        "positionOpportunity": { "enum": ["P0", "P1", "P2"] }
      }
    }
  }
}
