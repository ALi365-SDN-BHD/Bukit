{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bukit.dev/schemas/generative-answer-observation.v1.json",
  "title": "Bukit Generative Answer Observation Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "engine", "promptSetVersion", "locale", "collectedAt", "collectionMethod", "rows"],
  "properties": {
    "schema": { "const": "https://bukit.dev/schemas/generative-answer-observation.v1.json" },
    "schemaVersion": { "const": "1.0" },
    "engine": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "promptSetVersion": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "locale": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "collectionMethod": { "enum": ["api", "browser-export", "manual"] },
    "rows": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionKey", "promptVariant", "runIndex", "brandMentioned", "siteCited", "citedUrls", "citationPosition", "answerHash"],
        "properties": {
          "questionKey": { "type": "string", "pattern": "^question:sha256:[0-9a-f]{64}$" },
          "promptVariant": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "runIndex": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "brandMentioned": { "type": "boolean" },
          "siteCited": { "type": "boolean" },
          "citedUrls": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
          },
          "citationPosition": { "type": ["integer", "null"], "minimum": 1 },
          "answerHash": { "type": "string", "pattern": "^answer:sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
