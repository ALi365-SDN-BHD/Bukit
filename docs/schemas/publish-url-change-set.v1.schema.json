{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bukit.dev/schemas/publish-url-change-set.v1.json",
  "title": "Bukit Publish URL Change Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changes"
  ],
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "url",
          "semanticHash"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "added",
              "updated",
              "deleted"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "semanticHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
