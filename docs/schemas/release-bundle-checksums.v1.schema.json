{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bukit.dev/schemas/release-bundle-checksums.v1.json",
  "title": "Bukit Release Bundle Checksums",
  "type": "object",
  "required": ["schema", "schemaVersion", "fileCount", "bundleHash", "files"],
  "properties": {
    "schema": { "const": "https://bukit.dev/schemas/release-bundle-checksums.v1.json" },
    "schemaVersion": { "const": "1.0" },
    "fileCount": { "type": "integer", "minimum": 0 },
    "bundleHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hash", "size"],
        "properties": {
          "path": { "type": "string" },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
