{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bukit.dev/schemas/cli-error.v1.json",
  "title": "Bukit CLI Error Envelope",
  "type": "object",
  "required": ["schema", "version", "command", "exitCode", "errors"],
  "properties": {
    "schema": {
      "const": "https://bukit.dev/schemas/cli-error.v1.json"
    },
    "version": {
      "const": "1.0"
    },
    "command": {
      "type": ["string", "null"]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "showUsage"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "showUsage": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
