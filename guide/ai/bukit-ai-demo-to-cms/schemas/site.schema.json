{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bukit site.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "content",
    "theme"
  ],
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "markdown",
            "notion"
          ]
        },
        "markdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dir"
          ],
          "properties": {
            "dir": {
              "type": "string"
            },
            "defaultType": {
              "type": "string"
            }
          }
        },
        "notion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "databaseId",
            "tokenEnv"
          ],
          "properties": {
            "databaseId": {
              "type": "string"
            },
            "tokenEnv": {
              "type": "string"
            },
            "filterProperty": {
              "type": "string"
            },
            "filterType": {
              "type": "string"
            },
            "sortProperty": {
              "type": "string"
            },
            "sortDirection": {
              "enum": [
                "ascending",
                "descending"
              ]
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "collection",
              "notion"
            ],
            "properties": {
              "type": {
                "enum": [
                  "notion"
                ]
              },
              "name": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "collection": {
                "enum": [
                  "page",
                  "post",
                  "company",
                  "service"
                ]
              },
              "notion": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "databaseId",
                  "tokenEnv"
                ],
                "properties": {
                  "databaseId": {
                    "type": "string"
                  },
                  "tokenEnv": {
                    "type": "string"
                  },
                  "filterProperty": {
                    "type": "string"
                  },
                  "filterType": {
                    "type": "string"
                  },
                  "sortProperty": {
                    "type": "string"
                  },
                  "sortDirection": {
                    "enum": [
                      "ascending",
                      "descending"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "provider",
            "markdown"
          ],
          "not": {
            "required": [
              "sources"
            ]
          }
        },
        {
          "required": [
            "provider",
            "notion"
          ],
          "not": {
            "required": [
              "sources"
            ]
          }
        },
        {
          "required": [
            "sources"
          ],
          "not": {
            "required": [
              "provider"
            ]
          }
        }
      ]
    },
    "collections": {
      "type": "object"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "string"
        },
        "clean": {
          "type": "boolean"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    }
  }
}
