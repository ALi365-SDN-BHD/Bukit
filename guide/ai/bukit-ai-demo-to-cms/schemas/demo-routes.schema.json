{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bukit demo.routes.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pages"
  ],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "route",
          "type",
          "template"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "route": {
            "type": "string",
            "pattern": "^/"
          },
          "type": {
            "enum": [
              "Home",
              "Page",
              "PostList",
              "PostDetail",
              "CompanyList",
              "CompanyDetail",
              "ServiceList",
              "ServiceDetail",
              "Contact",
              "Join"
            ]
          },
          "template": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}