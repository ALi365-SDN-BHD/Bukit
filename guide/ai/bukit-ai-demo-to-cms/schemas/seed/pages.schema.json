{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pages",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "title",
      "slug",
      "type",
      "published"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "published": {
        "type": "boolean"
      },
      "language": {
        "type": "string"
      },
      "seoTitle": {
        "type": "string"
      },
      "seoDescription": {
        "type": "string"
      },
      "cover": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "type": {
        "enum": [
          "Home",
          "Page"
        ]
      },
      "template": {
        "type": "string"
      }
    }
  }
}