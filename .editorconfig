root = true

[*.{cs,csproj,props,targets}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,sh,ps1}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
